{
	"name": "pdfviewer",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/webcomponents/pdfviewer/src",
	"prefix": "lib",
	"projectType": "library",
	"tags": [],
	"targets": {
		"build": {
			"executor": "@nx/angular:package",
			"outputs": ["{workspaceRoot}/dist/{projectRoot}"],
			"options": {
				"project": "libs/webcomponents/pdfviewer/ng-package.json"
			},
			"configurations": {
				"production": {
					"tsConfig": "libs/webcomponents/pdfviewer/tsconfig.lib.prod.json"
				},
				"development": {
					"tsConfig": "libs/webcomponents/pdfviewer/tsconfig.lib.json"
				}
			},
			"defaultConfiguration": "production"
		},
		"test": {
			"executor": "@nx/jest:jest",
			"outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
			"options": {
				"jestConfig": "libs/webcomponents/pdfviewer/jest.config.ts"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"publish": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm publish --access=private",
				"cwd": "dist/libs/pdfviewer",
				"parallel": false
			}
		}
	}
}
