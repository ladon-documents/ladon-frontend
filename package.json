{
  "name": "@mind/draco-ui",
  "version": "0.12.2",
  "description": "",
  "private": true,
  "workspaces": [
    "api",
    "globals",
    "style",
    "ui",
    "wc/*"
  ],
  "scripts": {
    "build:api": "npm run build:all -w @ladon/api",
    "serve:api": "npm run serve -w @ladon/api",
    "build:globals": "npm run build -w @ladon/globals",
    "build:styles": "npm run build -w @ladon/style",
    "build:ui": "npm run build -w @ladon/ui",
    "build:clipboard": "npm run build -w @ladon/clipboard",
    "build:pdfviewer": "npm run build -w @ladon/pdfviewer",
    "build:mediaplayer": "npm run build -w ladon-mediaplayer",
    "build:audioplayer": "npm run build -w ladon-audioplayer",
    "build:imageeditor": "npm run build -w ladon-image-editor",
    "build:editor": "npm run build -w @ladon/editor",
    "build:wc": "npm run build:clipboard && npm run build:pdfviewer && npm run build:mediaplayer && npm run build:audioplayer && npm run build:imageeditor && npm run build:editor",
    "sync:wc:local": "node ./scripts/sync-local-webcomponents.mjs",
    "serve:ui": "npm run start -w @ladon/ui",
    "build:all": "npm run build:api && npm run build:globals && npm run build:styles && npm run build:ui",
    "release": "bash ./bundle.sh release"
  },
