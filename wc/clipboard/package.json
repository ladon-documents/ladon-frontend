{
  "name": "@ladon/clipboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dist:clear": "rimraf ./dist/{polyfills,main}.js",
    "build": "ng build  --output-hashing none",
    "postbuild": "webpack",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prettier:format": "prettier --write src"
  },
  "private": true,
  "files": [
    "dist/",
    "ladon-plugin.json",
    "ladon-plugin.md",
    "releasenotes.md"
  ],
  "prettier": {
    "printWidth": 120,
    "bracketSameLine": true
  },
  "publishConfig": {
    "registry": "https://nexus.mind-consulting.de/repository/npm-private/"
  }
}
