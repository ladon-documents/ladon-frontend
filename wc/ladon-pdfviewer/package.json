{
  "name": "@ladon/pdfviewer",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "dist:merge": "bash -c \"cat dist/ladon-pdfviewer/{polyfills,main}.js > dist/ladon-pdfviewer/ladon-pdfviewer.js\"",
    "dist:clear": "bash rm -rf dist/ladon-pdfviewer/{polyfills,main}.js",
    "start": "ng serve",
    "build": "ng build --output-hashing none",
    "postbuild": "npm run dist:merge",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "files": [
    "dist/",
    "ladon-plugin.json",
    "ladon-plugin.md",
    "releasenotes.md"
  ],
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/elements": "^19.0.6",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0",
    "ngx-extended-pdf-viewer": "22.1.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.7",
    "@angular/cli": "^19.0.7",
    "@angular/compiler-cli": "^19.0.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.6.2"
  },
  "publishConfig": {
    "registry": "https://nexus.mind-consulting.de/repository/npm-private/"
  }
}
